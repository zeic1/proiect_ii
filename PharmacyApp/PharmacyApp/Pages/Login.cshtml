@page
@model PharmacyApp.Pages.LoginModel
@{
    ViewData["Title"] = "Login";
}

<link rel="stylesheet" href="~/css/styles.css" />

<div class="container">
    <div class="auth-form">
        <h2>Login</h2>
        <form method="post">
            <input asp-for="Input.Email" type="email" placeholder="Email" required />
            <input asp-for="Input.Password" type="password" placeholder="Password" required />
            <button type="submit">Login</button>
        </form>
        <p>@Model.Message</p>
        <p class="redirect-text">Don't have an account? <a href="/Register">Register</a></p>
    </div>
</div>

<script src="~/js/scripts.js"></script>
