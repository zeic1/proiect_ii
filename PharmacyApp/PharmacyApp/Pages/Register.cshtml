@page
@model PharmacyApp.Pages.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<link rel="stylesheet" href="~/css/styles.css" />

<div class="container">
    <div class="auth-form">
        <h2>Register</h2>
        <form method="post">
            <input asp-for="Input.Username" type="text" placeholder="Username" required />
            <input asp-for="Input.Email" type="email" placeholder="Email" required />
            <input asp-for="Input.Password" type="password" placeholder="Password" required />
            <button type="submit">Register</button>
        </form>
        <p>@Model.Message</p>
        <p class="redirect-text">Already have an account? <a href="/Login">Login</a></p>
    </div>
</div>

<script src="~/js/scripts.js"></script>
